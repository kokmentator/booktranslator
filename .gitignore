# Dependencies
node_modules/

# Environment / secrets
.env
.env.local
*.key
*.pem
# Holds your API key — never commit it
data/engine.config.json
# Per-user runtime preferences / counters
data/style.config.json
data/usage.json

# Claude local settings
.claude/settings.local.json

# OS / editor
Thumbs.db
.DS_Store
*.swp

# Logs
*.log

# App-written runtime state under data/ (the server owns these; git cannot hold
# a coherent view of them). The demo book's project.json IS committed so a fresh
# clone opens with something to translate — everything the app writes on top is not.
data/*/backups/
data/*/exports/
data/*/exchange/
data/*/training/
data/*/chat.jsonl
